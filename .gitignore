# Data files & Datasets (shared offline via ModelScope, never committed)
# 例外：data/indexes/ 是划分与跨集去重的审计记录，随仓库分发。
data/*
!data/indexes/

# Model weights & LoRA adapters (any location)
# NOTE: *.bin / *.pt are intentionally broad — weight files of any naming land here.
*.safetensors
*.bin
*.pt
*.pth
*.gguf
model/
best/
checkpoints/

# OS / WSL
.DS_Store
Thumbs.db
*:Zone.Identifier

# Outputs: local only. Every generated artifact (annotations, LoRA adapters,
# predictions, submissions) stays out of the repository.
outputs/

# Internal working notes and platform runbook: kept in the local checkout,
# never published (README + docs/ carry everything an external user needs).
docs/handoff*.md
*handoff*.md
docs/sop*.md
AGENTS.md
